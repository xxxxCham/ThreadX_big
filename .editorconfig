# EditorConfig helps maintain consistent coding styles for multiple developers
# working on the same project across various editors and IDEs.
# https://editorconfig.org

root = true

# CRITICAL: DIRECTIVES_DEV.md MUST be preserved
[DIRECTIVES_DEV.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

[README.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

[.llmrc]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = true
end_of_line = lf

# Python files
[*.py]
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100
end_of_line = lf

# Type hints REQUIRED
# See DIRECTIVES_DEV.md for conventions

# JSON files
[*.json]
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

# YAML files
[*.{yml,yaml}]
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

# TOML files
[*.toml]
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

# Markdown files
[*.md]
charset = utf-8
trim_trailing_whitespace = false
insert_final_newline = true
end_of_line = lf

# Go files
[*.go]
charset = utf-8
indent_style = tab
indent_size = 1
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

# Batch files
[*.{bat,cmd}]
end_of_line = crlf

# Shell scripts
[*.sh]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf

# Note: See DIRECTIVES_DEV.md for code quality standards
# - Type hints mandatory for Python
# - Docstrings required (Google/NumPy style)
# - Max line 100 chars for Python
# - Tests coverage >80%
